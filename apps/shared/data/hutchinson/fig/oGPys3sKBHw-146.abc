X:1
T:Gioachino Rossini, William Tell Overture (1829)
%%id oGPys3sKBHw-146
%bars ?
%unsure exact pitch of some high ledger-line octaves in bars 5-8 (read from the figure, octave pairs)
%unsure last bar: only its first eighth is printed
M:2/4
L:1/8
K:E
%%score {1 | (2 3)}
V:1 clef=treble
V:2 clef=bass
V:3 clef=bass
[V:1] "C/E"!sf!([=g=g']4 | [gg'])[ee'] [=c=c'][ee'] | "E"!sf!([^g^g']4 | [gg'])[ee'] [Bb][ee'] |
"C#"!sf!([ee']4 | [ee'])[^e^e'] [cc'][ee'] || "C7"!sf!([^a^a']4 | [aa'])[=a=a'] [ee'][gg'] || "E/B"[gg'] x3 |]
[V:2] [=G,=CE]4 | [E,=G,=CE] z z2 | [^G,B,E]4 | [E,G,B,E] z z2 |
[^E,^G,C]4 | [C,E,G,C] z z2 || [=E,=G,]4 | [=C,E,G,] z z2 || [B,,E,^G,B,] x3 |]
[V:3] E,E,E,E, | x4 | E,E,E,E, | x4 |
C,C,C,C, | x4 || =C,C,C,C, | x4 || x4 |]
